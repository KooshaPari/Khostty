{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": false,
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["js/**/*.d.ts", "test/types.test-d.ts"]
}
